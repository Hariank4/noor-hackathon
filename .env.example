# Official Unstop registration URL (client to supply). Without it, Register buttons scroll to the "How to register" section.
NEXT_PUBLIC_UNSTOP_URL=
# Brochure file or URL (client to supply). Without it, the button shows "coming soon".
NEXT_PUBLIC_BROCHURE_URL=
# Production site URL (used for SEO / social cards)
NEXT_PUBLIC_SITE_URL=https://noorhackathon.com
# Set to 1 ONLY on preview deployments. Shows items awaiting client approval (fees, FAQ).
NEXT_PUBLIC_PREVIEW=
