# Registration link. Defaults to the client's Google Form (see next.config.ts); set this only to override it.
NEXT_PUBLIC_REGISTER_URL=
# Brochure file or URL (client to supply). Without it, the button shows "coming soon".
NEXT_PUBLIC_BROCHURE_URL=
# Production site URL (used for SEO / social cards)
NEXT_PUBLIC_SITE_URL=https://noorhackathon.com
